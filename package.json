{
  "name": "gq-games-api",
  "version": "0.0.0",
  "private": true,
  "description": "Research-first games API on Cloudflare with Alchemy, Effect, Hono, and Vite+",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --stage local-dev",
    "build": "node scripts/build-worker.ts",
    "preview": "alchemy dev --config scripts/preview-worker.ts --stage local-preview",
    "check": "vp check",
    "format": "vp fmt",
    "lint": "vp lint --deny-warnings",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:integration": "vp test --mode integration",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.1",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@effect/platform-node": "4.0.1",
    "@types/node": "24.19.1",
    "alchemy": "2.0.0-beta.81",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.29.1"
}
