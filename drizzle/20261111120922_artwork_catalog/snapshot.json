      "table": "api_key_registry"
    },
    {
      "value": "\"scopes\" in ('[]', '[\"catalog:read\"]', '[\"assets:read\"]', '[\"assets:read\",\"catalog:read\"]')",
      "name": "registry_scopes",
      "entityType": "checks",
      "table": "api_key_registry"
    },
    {
      "value": "\"expires_at\" is null or (typeof(\"expires_at\") = 'integer' and \"expires_at\" between 0 and 9007199254740991)",
      "name": "registry_expiry",
      "entityType": "checks",
      "table": "api_key_registry"
    },
    {
      "value": "\"revoked\" in (0, 1)",
      "name": "registry_revoked",
