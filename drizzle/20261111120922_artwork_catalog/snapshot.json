    },
    {
      "value": "typeof(\"steam_app_id\") = 'integer' and \"steam_app_id\" between 1 and 4294967295",
      "name": "snapshot_app_id",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "case when json_valid(\"event_id\") then json_type(\"event_id\") = 'text' and length(cast(json_extract(\"event_id\", '$') as blob)) > 0 and length(json_extract(\"event_id\", '$')) <= 128 else 0 end",
      "name": "snapshot_event_id",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "case when json_valid(\"title\") then json_type(\"title\") = 'text' and length(cast(json_extract(\"title\", '$') as blob)) > 0 and length(json_extract(\"title\", '$')) <= 512 else 0 end",
      "name": "snapshot_title",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"product_type\" in ('game', 'demo', 'dlc')",
      "name": "snapshot_product_type",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"base_app_id\" is null or (typeof(\"base_app_id\") = 'integer' and \"base_app_id\" between 1 and 4294967295 and \"base_app_id\" <> \"steam_app_id\" and \"product_type\" <> 'game')",
      "name": "snapshot_base_app_id",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"developers\" is null or case when json_valid(\"developers\") then json_type(\"developers\") = 'array' and json_array_length(\"developers\") <= 32 else 0 end",
      "name": "snapshot_developers",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"publishers\" is null or case when json_valid(\"publishers\") then json_type(\"publishers\") = 'array' and json_array_length(\"publishers\") <= 32 else 0 end",
      "name": "snapshot_publishers",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"supported_os\" is null or case when json_valid(\"supported_os\") then json_type(\"supported_os\") = 'array' and json_array_length(\"supported_os\") <= 3 else 0 end",
      "name": "snapshot_supported_os",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "\"release_status\" in ('upcoming', 'released', 'unknown')",
      "name": "snapshot_release_status",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "(\"release_date_kind\" = 'unknown' and \"release_date\" is null and \"release_window\" is null)\n        or (\"release_date_kind\" = 'exact' and \"release_date\" is not null and \"release_window\" is null\n          and \"release_date\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n          and coalesce(strftime('%Y-%m-%d', \"release_date\", '+0 days') = \"release_date\", 0))\n        or (\"release_date_kind\" = 'window' and \"release_date\" is null and \"release_window\" is not null\n          and case when json_valid(\"release_window\") then json_type(\"release_window\") = 'text'\n            and length(cast(json_extract(\"release_window\", '$') as blob)) > 0\n            and length(json_extract(\"release_window\", '$')) <= 256 else 0 end)",
      "name": "snapshot_release_date",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
      "value": "case when json_valid(\"source_url\") then json_type(\"source_url\") = 'text' and length(cast(json_extract(\"source_url\", '$') as blob)) > 0 and length(json_extract(\"source_url\", '$')) <= 2048 else 0 end",
      "name": "snapshot_source_url",
      "entityType": "checks",
      "table": "steam_application_snapshot"
    },
    {
